+  private var lastSilentRecoveryTimestamp = 0L
+  private var silentRecoveryCount = 0
+
+  private fun isLiveStreamRecoveryCandidate(e: PlaybackException): Boolean {
+    if (e.errorCode == PlaybackException.ERROR_CODE_BEHIND_LIVE_WINDOW ||
+        e.errorCode == PlaybackException.ERROR_CODE_IO_READ_POSITION_OUT_OF_RANGE ||
+        e.errorCode == PlaybackException.ERROR_CODE_IO_BAD_HTTP_STATUS) {
+      return true
+    }
+    var cause: Throwable? = e
+    while (cause != null) {
+      val name = cause.javaClass.simpleName
+      if (name.contains("BehindLiveWindow") ||
+          name.contains("PlaylistReset") ||
+          name.contains("InvalidResponseCodeException")) {
+        return true
+      }
+      cause = cause.cause
+    }
+    return false
+  }
+
+  private fun trySilentRecovery(error: PlaybackException): Boolean {
+    val now = System.currentTimeMillis()
+    if (now - lastSilentRecoveryTimestamp > 15000) {
+      silentRecoveryCount = 0
+    }
+    lastSilentRecoveryTimestamp = now
+    silentRecoveryCount++
+
+    if (silentRecoveryCount <= 3) {
+      android.util.Log.w("ExpoVideo", "Live stream error (${error.errorCode} / ${error.message}), attempting silent recovery #$silentRecoveryCount")
+      player.seekToDefaultPosition()
+      player.prepare()
+      player.play()
+      return true
+    }
+    android.util.Log.w("ExpoVideo", "Silent recovery limit exceeded ($silentRecoveryCount/3), passing error to JS")
+    return false
+  }
